# macOS system files
.DS_Store

# Vault folders (vaults now live outside this repo, e.g. ~/obsidian-vaults/MyVault/)
# kept here in case a vault is ever tested locally inside this repo
MyVault/
MyVault2/

# Obsidian system folder (if any used for testing)
.obsidian/

# Ignore markdown files except README
*.md
!README.md
!vault-templates/*/templates/*.md

# Ignore assets/
assets/

# Ignore Python/UV environment artifacts
.python-version
.venv/
__pycache__/
*.pyc
uv.lock
logpose.egg-info/

# VSCode or JetBrains settings (if you use them)
.vscode/
.idea/

